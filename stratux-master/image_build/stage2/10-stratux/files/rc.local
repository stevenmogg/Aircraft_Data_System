#!/bin/sh -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.

# Print the IP address
_IP=$(hostname -I) || true
if [ "$_IP" ]; then
  printf "My IP address is %s\n" "$_IP"
fi


#
# Rotate logs on boot. Ensures the log files are clean after a boot for easier
# viewing of the current boot log from the web interface.
#
/usr/sbin/logrotate /etc/logrotate.conf

# Large console font for MPI3508 HDMI panel (720x480 scaled to 3.5")
if [ -f /usr/share/consolefonts/Lat15-TerminusBold32x16.psf.gz ]; then
  setfont Lat15-TerminusBold32x16 2>/dev/null || true
fi

# Cozy data SMB share (AvPlan flight plan drop folder)
if [ -x /usr/sbin/smbd ] && ! pgrep -x smbd >/dev/null 2>&1; then
  /usr/sbin/smbd
fi

exit 0
