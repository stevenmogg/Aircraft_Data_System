ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev
update_config=1
country=AU

# Optional USB Wi-Fi dongle uplink (backup to onboard wlan0 client)
network={
    ssid="IdeasMan_iPhone"
    psk="CHANGE_ME"
    key_mgmt=WPA-PSK
    priority=20
}

