        <mxCell id="fixbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="Data products&lt;br&gt;&lt;b&gt;Live now:&lt;/b&gt; MGL_AT_PITCH / ROLL / HEAD / YAW / SLIP / G / TURN&lt;br&gt;&lt;b&gt;Proposed:&lt;/b&gt; CTRL_ROLL_COUNT · CTRL_PITCH_COUNT · rates · errors · ZERO_VALID&lt;br&gt;Historian samples FIX. Stratux still owns STRX_* attitude." vertex="1">
          <mxGeometry height="90" width="720" x="40" y="520" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;" value="Rules that must not change&lt;br&gt;1. Nano never drives Airtalk (no MCU TX on the bus).&lt;br&gt;2. Nano GPIO is not 5 V tolerant.&lt;br&gt;3. Keep invert=0 hardware UART when encoders are enabled (software-UART ISR would steal encoder edges).&lt;br&gt;4. FIX plugin remains sole owner of the Nano USB port." vertex="1">
          <mxGeometry height="110" width="770" x="780" y="520" as="geometry" />
        </mxCell>
      </root>
