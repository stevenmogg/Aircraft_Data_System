        </mxCell>
        <mxCell id="div" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Level shift&lt;br&gt;10 kΩ / 18 kΩ&lt;br&gt;≈ 3.21 V at D4" vertex="1">
