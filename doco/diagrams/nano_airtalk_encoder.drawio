        <mxCell id="bus" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="MGL Airtalk bus&lt;br&gt;single-wire · ~5 V Space&lt;br&gt;19200 8N1 · idle high at tap" vertex="1">
