  <diagram id="elec" name="3 Encoder electrical">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;" value="Encoder electrical interface — Option A confirmed (4.7 kΩ to 3.3 V)" vertex="1">
          <mxGeometry height="30" width="1000" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="optA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="Option A — NPN / open-collector (CONFIRMED)&lt;br&gt;&lt;br&gt;Encoder VCC = 5 V&lt;br&gt;Encoder 0V = Nano GND&lt;br&gt;A and B each: 4.7 kΩ to Nano 3.3 V, then GPIO&lt;br&gt;&lt;br&gt;High = 3.3 V  ·  Low = encoder sink&lt;br&gt;This is the aircraft wiring." vertex="1">
          <mxGeometry height="170" width="420" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="optB" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#f5f5f5;strokeColor=#666666;" value="Option B — push-pull 5 V (NOT USED)&lt;br&gt;&lt;br&gt;These encoders are NPN, not push-pull.&lt;br&gt;Keep this note only for a different encoder.&lt;br&gt;Would have been 10 kΩ / 18 kΩ per A/B." vertex="1">
          <mxGeometry height="170" width="420" x="490" y="70" as="geometry" />
        </mxCell>
        <mxCell id="optX" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#f8cecc;strokeColor=#b85450;" value="Do not&lt;br&gt;&lt;br&gt;• 12–24 V encoder VCC into this Nano&lt;br&gt;• 5 V logic high straight into D2–D7&lt;br&gt;• share D3 or D4 with encoders&lt;br&gt;• run USB &lt;b&gt;test&lt;/b&gt; with Airtalk still on D4" vertex="1">
          <mxGeometry height="170" width="360" x="940" y="70" as="geometry" />
        </mxCell>
        <mxCell id="schA" parent="1" style="shape=mxgraph.electrical.abstract.signals;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=16;fontFamily=Courier New;fontSize=12;" value="+3.3 V&lt;br&gt;   │&lt;br&gt;  4.7 kΩ&lt;br&gt;   │&lt;br&gt;Enc A ───┴──── D2 or D6&lt;br&gt;&lt;br&gt;Enc 0V ──────── GND" vertex="1">
          <mxGeometry height="160" width="280" x="40" y="270" as="geometry" />
        </mxCell>
        <mxCell id="schAl" parent="1" style="text;html=1;fontStyle=2;" value="Option A one channel" vertex="1">
          <mxGeometry height="20" width="280" x="40" y="430" as="geometry" />
        </mxCell>
        <mxCell id="schB" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;fontSize=12;" value="Enc A ── 10 kΩ ──●──── GPIO&lt;br&gt;                  │&lt;br&gt;                18 kΩ&lt;br&gt;                  │&lt;br&gt;Enc 0V ───────────┴──── GND" vertex="1">
          <mxGeometry height="160" width="320" x="490" y="270" as="geometry" />
        </mxCell>
        <mxCell id="schBl" parent="1" style="text;html=1;fontStyle=2;" value="Option B one channel (repeat ×4)" vertex="1">
          <mxGeometry height="20" width="320" x="490" y="430" as="geometry" />
        </mxCell>
        <mxCell id="bench" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Bench sequence before aircraft wiring&lt;br&gt;1. Power one encoder from 5 V only. Common GND with the scope.&lt;br&gt;2. Scope A, then B, while rotating slowly. Note idle level, high voltage, and whether a pull-up is required.&lt;br&gt;3. Confirm A leads B one way and lags the other (~90°).&lt;br&gt;4. Count A cycles over one shaft turn (expect ~600 if the marking is PPR).&lt;br&gt;5. Measure supply current at rest and while turning.&lt;br&gt;6. Only then add the divider or 3.3 V pull-ups and connect one axis to the Nano." vertex="1">
          <mxGeometry height="160" width="770" x="40" y="470" as="geometry" />
        </mxCell>
        <mxCell id="mech" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Aircraft install notes&lt;br&gt;Twisted A/B pairs, shield to Nano GND at one end.&lt;br&gt;Keep encoder leads away from Airtalk and ignition leads.&lt;br&gt;Incremental only: zero at known stick/aileron neutral after power-up.&lt;br&gt;No Z/index on the labelled units." vertex="1">
          <mxGeometry height="160" width="460" x="840" y="470" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="usbpath" name="4 USB and FIX path">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t4" value="USB stream and software path (backward compatible)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fw" value="Nano firmware&lt;br&gt;HW UART D4 @ 19200&lt;br&gt;x4 quadrature ISRs on D2/D5 and D6/D7&lt;br&gt;loop: dump Airtalk bytes + 100 Hz control line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dline" value="Keep existing Airtalk dump&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;D t=&amp;lt;us&amp;gt; n=&amp;lt;n&amp;gt; hex=82 … 83&lt;/font&gt;&lt;br&gt;Existing FIX plugin keeps working." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cline" value="Add control line ~100 Hz&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;C t=&amp;lt;us&amp;gt; roll= n pitch= n&lt;br&gt;rd= n pd= n rerr= n perr= n z=0|1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="165" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cmds" value="USB commands (host → Nano)&lt;br&gt;help · stats · invert 0|1 · test&lt;br&gt;add: zero · zero roll · zero pitch" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="800" y="70" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fixplugin" value="fix_gateway_plugins/cozy_mgl_airtalk&lt;br&gt;Sole USB owner&lt;br&gt;D lines → FrameAssembler → MGL_AT_*&lt;br&gt;C lines → CTRL_* writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fixkeys" value="FIX keys (underscores)&lt;br&gt;CTRL_ROLL_COUNT  CTRL_PITCH_COUNT&lt;br&gt;CTRL_ROLL_RATE   CTRL_PITCH_RATE&lt;br&gt;CTRL_ROLL_ERRORS CTRL_PITCH_ERRORS&lt;br&gt;CTRL_ZERO_VALID" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="270" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="hist" value="Historian&lt;br&gt;Add CTRL_* to 10 Hz table first&lt;br&gt;Nano still counts every edge;&lt;br&gt;100 Hz FIX updates, 10 Hz log until a faster control table is justified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="760" y="270" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="web" value="Web / debug&lt;br&gt;/debug/mgl/airtalk keeps Airtalk watch&lt;br&gt;Add encoder counts/rates to LIVE or a small Controls debug strip&lt;br&gt;Optional zero button → USB zero command via FIX plugin later" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;" edge="1" parent="1" source="fw" target="fixplugin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;" edge="1" parent="1" source="fixplugin" target="fixkeys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="endArrow=block;html=1;" edge="1" parent="1" source="fixkeys" target="hist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
